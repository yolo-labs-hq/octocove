{
  // Local/test config: Miniflare, local D1, the demo and CI read this file; IDs are placeholders.
  // Production is generated from it by scripts/production-config.mjs (real D1 id, the
  // api.octocove.com custom domain, committed vars, no artifacts binding) and deployed by
  // the production deploy; see docs/OPERATIONS.md. Keep this file the
  // single source for bindings, DO migrations, queues and cron. The integrator runner and
  // Cloudflare Containers topology are provisional.
  "name": "octocove-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octocove",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "TASKS", "class_name": "TaskCoordinator" }, { "name": "REMOTE_SWEEPER", "class_name": "RemoteSweeper" }, { "name": "WEBHOOK_DISPATCHER", "class_name": "WebhookDispatcher" }] },
  "migrations": [{ "tag": "v1-task-coordinator", "new_sqlite_classes": ["TaskCoordinator"] }, { "tag": "v2-remote-sweeper", "new_sqlite_classes": ["RemoteSweeper"] }, { "tag": "v3-webhook-dispatcher", "new_sqlite_classes": ["WebhookDispatcher"] }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "octocove-events" }],
    "consumers": [{ "queue": "octocove-events", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "octocove-events-dlq" }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "octocove" }]
}
