{
  "protocol": "octocove-conformance/1",
  "harnessVersion": "1.4.0",
  "contract": "docs/reference/CLIENT_CONTRACT.md",
  "repetitions": 20,
  "shards": [
    "a/artifacts/ref",
    "a/artifacts/repo",
    "a/github/ref",
    "a/forgejo/ref",
    "b/artifacts/ref",
    "b/artifacts/repo",
    "b/github/ref",
    "b/forgejo/ref",
    "c/artifacts/ref",
    "c/artifacts/repo",
    "c/github/ref",
    "c/forgejo/ref"
  ],
  "maxWorkers": 1,
  "matrix": {
    "archetypes": [
      "a",
      "b",
      "c"
    ],
    "providers": [
      "artifacts",
      "github",
      "forgejo"
    ],
    "topologies": [
      "ref",
      "repo"
    ],
    "targets": [
      "refs/heads/main",
      "refs/heads/integration"
    ]
  },
  "localPairings": [
    "artifacts/ref",
    "artifacts/repo",
    "github/ref",
    "forgejo/ref"
  ],
  "unsupportedByDesign": {
    "artifacts/ref": {
      "selected": false,
      "reason": "unsupported-by-design: Artifacts repository-scoped tokens cannot confine a claimant to one ref of a shared repository; the product allocates a task repository (artifacts/repo) instead"
    }
  },
  "localProviderDouble": "local Artifacts REST/fork/subscription and BYO credential-authority doubles + explicit HTTPS-to-local-bare translation; native filesystem Git does not enforce provider token isolation; CLI registered Git transport to native local bare paths",
  "thresholds": {
    "casWinners": 1,
    "unauthorizedLandings": 0,
    "staleLandings": 0,
    "prematureDependents": 0,
    "wrongRepositoryTokens": 0,
    "logicalReceiptDuplicates": 0,
    "exactRemoteReceipts": 20,
    "reconciliationMs": 60000,
    "adapterOnlyP95Ms": 1000
  },
  "scenarios": [
    {
      "id": "journey",
      "local": "driver",
      "assertions": [
        "complete-authorized-journey"
      ]
    },
    {
      "id": "exact-record",
      "local": "execute",
      "assertions": [
        "exact-tuple",
        "checks-policy",
        "fence-binding",
        "remote-receipt",
        "receipt-dedupe",
        "failed-check-denied"
      ]
    },
    {
      "id": "exact-preview",
      "local": "execute",
      "assertions": [
        "source-sha-exact",
        "candidate-sha-exact"
      ]
    },
    {
      "id": "approval-denials",
      "local": "execute",
      "assertions": [
        "ordinary-agent-denied",
        "stale-tuple-denied",
        "unauthorized-auto-land-denied",
        "source-credential-boundary"
      ]
    },
    {
      "id": "crash-push-before-record",
      "local": "execute",
      "fault": "signed-completion-before-dispatch",
      "assertions": [
        "held-fence",
        "pending-is-not-landed",
        "remote-receipt",
        "receipt-dedupe",
        "reconciliation-bound"
      ]
    },
    {
      "id": "crash-record-before-export",
      "local": "execute",
      "fault": "after-signed-completion-before-export-load",
      "assertions": [
        "authoritative-record",
        "export-replay",
        "remote-receipt"
      ]
    },
    {
      "id": "event-disorder-dependencies",
      "local": "execute",
      "fault": "new-old-new-and-dropped-landing",
      "assertions": [
        "events-not-authority",
        "no-premature-dependent",
        "accepted-result-dependency"
      ]
    },
    {
      "id": "provider-restriction",
      "local": "execute",
      "fault": "upstream-update-hook-reject-target",
      "assertions": [
        "no-bypass",
        "restricted-receipt",
        "unchanged-target"
      ]
    },
    {
      "id": "identity-denials",
      "local": "execute",
      "fault": "expired-revoked-rotated-jti-wrong-audience-project-task-subject",
      "assertions": [
        "invalid-identity-cannot-approve"
      ]
    },
    {
      "id": "retention-gate",
      "local": "execute",
      "assertions": [
        "cleanup-respects-source-ownership",
        "source-and-checkout-preserved"
      ]
    },
    {
      "id": "cas-race",
      "local": "execute",
      "fault": "two-lane-concurrent-land-admission",
      "assertions": [
        "one-cas-winner",
        "no-partial-target-write"
      ]
    },
    {
      "id": "stale-source-base-intent",
      "local": "execute",
      "assertions": [
        "stale-source-denied",
        "stale-base-denied",
        "stale-intent-denied",
        "target-cas-no-stale-landing"
      ],
      "fault": "pinned-source-mismatch refused at submission admission for every mapping; canonical-advance-after-enqueue-before-compute; intent-mismatch; upstream advance after land token mint before native CAS push"
    },
    {
      "id": "conflict-repair-fresh-approval",
      "local": "execute",
      "assertions": [
        "conflict-recorded",
        "new-exact-repair-approval",
        "remote-repair-receipt"
      ],
      "fault": "approved-source-replaced-by-conflicting-source-then-repaired"
    },
    {
      "id": "exact-preview-retention",
      "local": "execute",
      "assertions": [
        "exact-preview-fetch",
        "ownership-safe-cleanup",
        "client-checkout-preserved"
      ]
    },
    {
      "id": "integration-promotion",
      "local": "execute",
      "assertions": [
        "separate-promotion-authority",
        "old-approval-refused",
        "remote-promotion-receipt"
      ]
    },
    {
      "id": "mixed-lanes-targets",
      "local": "execute",
      "assertions": [
        "target-isolation",
        "mapping-isolation"
      ]
    },
    {
      "id": "tree-graft",
      "local": "blocked",
      "reason": "versioned seed/anchor/graft transform not implemented",
      "assertions": [
        "exact-seed-tree",
        "anchor-bound-transform",
        "remote-graft-receipt"
      ]
    },
    {
      "id": "fenced-migration",
      "local": "blocked",
      "reason": "fenced host migration not qualified",
      "assertions": [
        "writers-reconciled",
        "old-grants-revoked",
        "historical-identities-preserved",
        "remote-migration-receipt"
      ]
    },
    {
      "id": "mid-fetch-mid-rescue-credentials",
      "local": "blocked",
      "reason": "local filesystem Git cannot prove in-flight upstream credential expiry/revocation",
      "assertions": [
        "upstream-fetch-expiry-refused",
        "upstream-rescue-revocation-refused"
      ]
    },
    {
      "id": "runtime-credential-isolation",
      "local": "blocked",
      "reason": "real runtime/upstream isolation evidence required; synthetic pre-dispatch refusal cannot qualify",
      "assertions": [
        "no-wrong-repository-token-use",
        "submitted-code-cannot-obtain-canonical-credential"
      ]
    },
    {
      "id": "production-events",
      "local": "blocked",
      "reason": "Production event driver evidence is not registered; local event protocol fixtures cannot qualify a journey",
      "assertions": [
        "registered-event-oracles"
      ]
    }
  ],
  "machineVariants": [
    "policy_bot",
    "github_actions",
    "workers_cron",
    "signed_cli"
  ],
  "timingBoundaries": {
    "adapterOnlyMs": "driver wall time minus awaited API/native/subprocess transport; no provider or CLI startup time credited as wrapper overhead",
    "reconciliationMs": "injected post-push crash to authoritative receipt read",
    "nativeMs": "production runner start through signed completion",
    "cellMs": "repetition start through repository file cleanup; Worker/D1 teardown is confirmed separately per cell segment",
    "phasesMs": "additive scenario phase durations within cellMs; prepare phases include subsequent transitions until the next named boundary",
    "operationsMs": "overlapping awaited fixture repository/provision/cleanup and native runner durations; never sum with phases or adapter transport",
    "fixtureTimings": "once-per-segment Worker/D1 bootMs and teardownMs, with explicit cleanupConfirmed"
  },
  "maxShardSeconds": 1500,
  "maxSmokeSeconds": 300,
  "rawTimingCap": 20,
  "reportOnly": true,
  "eventOracles": "tools/conformance/events/oracles.mjs",
  "cellSeconds": null,
  "teardownSeconds": 60,
  "machineApprovalAssertions": [
    "machine-policy_bot-positive",
    "machine-policy_bot-expired",
    "machine-policy_bot-wrong-audience",
    "machine-policy_bot-replayed",
    "machine-policy_bot-revoked",
    "machine-github_actions-positive",
    "machine-github_actions-expired",
    "machine-github_actions-wrong-audience",
    "machine-github_actions-replayed",
    "machine-github_actions-revoked",
    "machine-workers_cron-positive",
    "machine-workers_cron-expired",
    "machine-workers_cron-wrong-audience",
    "machine-workers_cron-replayed",
    "machine-workers_cron-revoked",
    "machine-signed_cli-positive",
    "machine-signed_cli-expired",
    "machine-signed_cli-wrong-audience",
    "machine-signed_cli-replayed",
    "machine-signed_cli-revoked",
    "machine-self-approval",
    "machine-ordinary-agent"
  ],
  "budget": {
    "measuredRepetitionSeconds": {
      "a": 48,
      "b": 60,
      "c": 52
    },
    "marginFraction": 0.15,
    "bootSeconds": 20,
    "teardownSeconds": 60,
    "maxInvocationSeconds": 1500
  }
}
