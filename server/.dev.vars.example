# Local development only. Replace placeholders; never commit .dev.vars.
AUTH_DEV_LOCAL=true
AUTH_ALLOWED_ORIGINS=http://localhost:8790
OIDC_ISSUER=http://localhost:9000
OIDC_CLIENT_ID=example-client
OIDC_CLIENT_SECRET=<registered-client-secret>
OIDC_REDIRECT_URI=http://localhost:8790/auth/callback
OCTOCOVE_ISSUER=http://localhost:8790
DELEGATION_PRIVATE_JWK={}
DELEGATION_PUBLIC_JWKS={"keys":[]}
AUTH_RECOVERY_KEY=<base64url-32-byte-key>
PROJECT_CREATORS=http://localhost:9000|<subject>
ARTIFACTS_ACCOUNT_ID=<your-account-id>
ARTIFACTS_API_TOKEN=<your-api-token>
AUDIT_CURSOR_SECRET=<random-cursor-secret>
# Optional receipt HMAC signer; unset leaves export pending.
# INTEGRATOR_RUN_SECRET=<random-signing-secret>
