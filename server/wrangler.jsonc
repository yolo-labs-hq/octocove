// Example resource names only. Replace them with resources in your own account.
{
  "name": "example-octocove",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-octocove",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TASKS",
        "class_name": "TaskCoordinator"
      },
      {
        "name": "REMOTE_SWEEPER",
        "class_name": "RemoteSweeper"
      },
      {
        "name": "WEBHOOK_DISPATCHER",
        "class_name": "WebhookDispatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskCoordinator",
        "RemoteSweeper",
        "WebhookDispatcher"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "example-events"
      }
    ],
    "consumers": [
      {
        "queue": "example-events",
        "dead_letter_queue": "example-events-dlq"
      }
    ]
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "example-namespace"
    }
  ]
}
