{
  "name": "@yolo-labs/octocove",
  "license": "Apache-2.0",
  "version": "0.24.0",
  "description": "The octo command-line client for the Octocove API: login, projects, repositories, tasks, lanes and candidates.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yolo-labs-hq/octocove.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/yolo-labs-hq/octocove/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/yolo-labs-hq/octocove/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "octo": "dist/octocove.mjs",
    "octocove": "dist/octocove.mjs",
    "octocove-human-credential": "dist/octocove-human-credential.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && node build.mjs",
    "prepack": "cp ../../LICENSE ../../NOTICE .",
    "typecheck": "timeout 300 tsc -p tsconfig.json",
    "test": "CI=1 timeout 300 vitest run --maxWorkers=1 --minWorkers=1 --no-file-parallelism < /dev/null"
  },
  "devDependencies": {
    "@yolo-labs/octocove-client": "workspace:0.24.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
